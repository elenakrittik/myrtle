FROM rust:1-bookworm AS base
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev cmake && rm -rf /var/lib/apt/lists/*

FROM base AS dev_builder
RUN cargo install cargo-watch

FROM dev_builder AS dev
CMD ["cargo", "watch", "-x", "run --bin discord", "-w", "src", "-w", "Cargo.toml"]

FROM base AS release_builder
COPY . .
RUN cargo build --release --bin discord

FROM debian:bookworm-slim AS release
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=release_builder /workspace/target/release/discord /app/discord
CMD ["/app/discord"]
